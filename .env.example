ANTHROPIC_API_KEY=
# Model used by all agents
WORKBENCH_MODEL=claude-sonnet-5-5
# 1 = deterministic canned responses, no API calls (use for dev/tests)
MOCK_LLM=1
# Optional, wins over MOCK_LLM: mock | live | record | replay
# record and replay need LLM_SCENARIO_DIR (recorded answers: see docs/development.md, "LLM modes")
# LLM_MODE=mock
# LLM_SCENARIO_DIR=demo/scenarios/todo-app
# replay only: error = fail on a missing answer, mock = use the mock output instead
# LLM_REPLAY_FALLBACK=error
DATABASE_URL=sqlite:///./workbench.db
WORKSPACES_DIR=./workspaces
# Developer attempts per bug before it is left open
DEFAULT_MAX_FIX_RETRIES=3
# Story points the first sprint commits to (later sprints follow the retrospective)
DEFAULT_CAPACITY=10
# The orchestrator stops starting new sprints after this many
MAX_SPRINTS=3
# Cost estimate: USD per million tokens, Claude Sonnet 5.5 list price; change if you use another model
LLM_PRICE_INPUT_PER_MTOK=2.0
LLM_PRICE_OUTPUT_PER_MTOK=10.0
